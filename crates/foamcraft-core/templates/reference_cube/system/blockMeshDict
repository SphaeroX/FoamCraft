  FoamCraft reference case: a 1 m cube in a wind tunnel (pipeline test only).
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}

// Tunnel from x = -4 to 10 m, y and z from -4 to 4 m; cells of 0.5 m.
scale 1;

vertices
(
    (-4 -4 -4) (10 -4 -4) (10 4 -4) (-4 4 -4)
    (-4 -4  4) (10 -4  4) (10 4  4) (-4 4  4)
);

blocks
(
    hex (0 1 2 3 4 5 6 7) (28 16 16) simpleGrading (1 1 1)
);

boundary
(
    inlet  { type patch; faces ((0 4 7 3)); }
    outlet { type patch; faces ((1 2 6 5)); }
    sides
    {
        type patch;
        faces ((0 1 5 4) (3 7 6 2) (0 3 2 1) (4 5 6 7));
    }
);
