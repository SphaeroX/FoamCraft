  FoamCraft reference case: a 1 m cube in a wind tunnel (pipeline test only).
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      k;
}

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 0.015;

boundaryField
{
    inlet  { type fixedValue; value uniform 0.015; }
    outlet { type inletOutlet; inletValue uniform 0.015; value uniform 0.015; }
    sides  { type slip; }
    cube   { type kqRWallFunction; value uniform 0.015; }
}
